<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos 차량 권한: 앱이 실제로 쓰는 조회 권한만 선언. 출시 전 App Market 승인 범위와 다시 맞춘다. -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />        <!-- TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />         <!-- Brake -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" /> <!-- SteeringWheel 각도 -->

    <!-- AAOS 표준 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />      <!-- GEAR_SELECTION, PARKING_BRAKE_ON -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />           <!-- PERF_VEHICLE_SPEED -->
    <!-- HAZARD_LIGHTS_STATE에 필요한 CAR_EXTERIOR_LIGHTS는 signature|privileged라 서드파티 앱에 승인되지 않음(에뮬레이터 실측) → 선언하지 않음 -->

    <application
        android:name=".SideCoachApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SideCoach">

        <!-- CCP(로터리) 미지원: 필수 조작은 터치로 완결 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SideCoach">
            <!-- 주행 중 사용을 위한 DO 선언 (AAOS 표준 키. Pleos 문서에 키 이름 없음 → 확인 필요) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
